# ==== ZIVV local dev — COPY to .env and fill. NEVER commit real .env ====
NODE_ENV=development

# --- API ---
PORT=4000
API_PUBLIC_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me-64-hex-chars-min
REFRESH_SECRET=change-me-another-64-hex
SESSION_SECRET=change-me-session

# --- Postgres / Redis ---
DATABASE_URL=postgresql://zivv:zivv@localhost:5432/zivv?schema=public
REDIS_URL=redis://localhost:6379

# --- S3-compatible object storage (MinIO local / AWS prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=zivv-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
CDN_BASE_URL=http://localhost:9000/zivv-media

# --- AI provider (SERVER ONLY — never VITE_*) ---
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL_CHAT=gpt-4o-mini
AI_MODEL_VISION=gpt-4o-mini
AI_MODEL_IMAGE=dall-e-3
AI_STT_PROVIDER=whisper
AI_TTS_PROVIDER=native

# --- Realtime / calls (TURN for production) ---
TURN_URL=
TURN_USER=
TURN_PASS=

# --- Payments (SERVER ONLY, verify via provider webhooks) ---
PAYMENTS_PROVIDER=manual
PAYMENTS_WEBHOOK_SECRET=

# --- Admin bootstrap (hashed server-side; rotate after first login) ---
ADMIN_BOOTSTRAP_USER=king
ADMIN_BOOTSTRAP_PASS_HASH=
ADMIN_TOTP_ISSUER=ZIVV-King

# --- Moderation / antivirus ---
CLAMAV_HOST=
CONTENT_MODERATION_PROVIDER=
