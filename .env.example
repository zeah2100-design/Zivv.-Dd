# ZIVV — Noir Aurora Edition
# انسخ هذا الملف باسم .env للتطوير المحلي. ملف .env متجاهل في git.
# على Vercel: Settings > Environment Variables > أضف نفس هذه المفاتيح.

# ===== الذكاء الاصطناعي (مطلوب) =====
# المفتاح يُقرأ في api/ai.js و lib/config.js عبر process.env فقط
GEMINI_API_KEY=PUT_YOUR_GEMINI_KEY_HERE
# اختياري: اسم الموديل (الافتراضي gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# ===== قاعدة البيانات =====
# SQLite محلي (الافتراضي) — لا يحتاج إعداد
SQLITE_PATH=./data/zivv.db
# لتفعيل Supabase بدل SQLite:
# USE_SUPABASE=true
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ===== السيرفر =====
PORT=8787
